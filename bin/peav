foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $file) {
    if (file_exists($file)) {
        require_once $file;
        break;
    }
}

use Symfony\Component\Console\Application;

$application = new Application('Peav EAV CLI', '1.0.0');

// Additional dynamic command loading if database connection is configured
$application->run();
