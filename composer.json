{
  "name": "wiredupdev/peav",
  "description": "High-utility and performant PHP Entity-Attribute-Value (EAV) library built on Doctrine DBAL.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Felipe de Almeida Baccaro",
      "email": "wiredupdev@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "doctrine/dbal": "^4.0",
    "monolog/monolog": "^3.0",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "symfony/cache": "^7.0",
    "symfony/console": "^7.0",
    "symfony/event-dispatcher": "^7.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.11",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "WireUpDev\\Peav\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WireUpDev\\Peav\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/peav"
  ],
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:coverage": "vendor/bin/phpunit --coverage-text",
    "phpstan": "vendor/bin/phpstan analyse"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable"
}
